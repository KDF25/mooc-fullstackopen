{
  "name": "healthapp",
  "version": "1.0.0",
  "description": "Health app for Full Stack Open TypeScript course",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "calculateBmi": "tsc && node --experimental-strip-types bmiCalculator.ts",
    "calculateExercises": "tsc && node --experimental-strip-types exerciseCalculator.ts",
    "start": "node --experimental-strip-types index.ts",
    "dev": "concurrently \"tsc --watch\" \"node --watch --experimental-strip-types index.ts\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
